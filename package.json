{
  "name": "dsh-lingxu-ctf",
  "version": "1.0.11",
  "description": "DSH 凌虚竞赛插件：查看赛题、管理环境、编排解题 agent，并保存提交记录和 writeup。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./lingxu": "./lib/lingxu.js",
    "./platforms": "./lib/platforms.js",
    "./store": "./lib/store.js",
    "./team-events": "./lib/team-events.js",
    "./package.json": "./package.json",
    "./stage-tools": "./lib/stage-tools.js"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tests/smoke-live.mjs",
    "e2e": "node tests/e2e-live.mjs",
    "verify": "bash scripts/verify.sh"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "ctf",
    "lingxu",
    "cordis",
    "plugin",
    "security"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dsh": {
    "runtime": {
      "node": ">=18",
      "dependencyPolicy": "host-managed",
      "hostRuntimeManaged": true,
      "lockHostRuntime": false
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "injectWhy": "客户端界面依赖这三个 DSH 模块：modules 提供客户端装配，locale 提供标签翻译，ui-conversation 提供 sessions 列表和顶部视图槽。缺少 ui-conversation 时无法按会话预设控制 CTF 标签，只能退回通用显示。模块名称随 DSH 版本变化，升级 DSH 后请重新验证。",
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "author": "D1a0y1bb",
  "homepage": "https://github.com/D1a0y1bb/lingxu-ctf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D1a0y1bb/lingxu-ctf.git"
  },
  "bugs": {
    "url": "https://github.com/D1a0y1bb/lingxu-ctf/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
