{
  "name": "dsh-lingxu-ctf",
  "version": "1.0.2",
  "description": "DSH 凌虚竞赛平台 CTF 解题插件：自动枚举赛题/理论题/排行榜，并发 agent 团队协同解题，自动提交 flag 与生成 writeup。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./lingxu": "./lib/lingxu.js",
    "./platforms": "./lib/platforms.js",
    "./store": "./lib/store.js",
    "./package.json": "./package.json",
    "./stage-tools": "./lib/stage-tools.js"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tests/smoke-live.mjs",
    "e2e": "node tests/e2e-live.mjs",
    "verify": "bash scripts/verify.sh"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "ctf",
    "lingxu",
    "cordis",
    "plugin",
    "security"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "injectWhy": "⚠️ 这三个包一个都不能删（哪怕看起来「没被 import」）：inject 决定客户端 boot graph 里组装哪些插件行，而我们只能通过 ctx.get('sessions') 拿会话列表。sessions 服务由 @deepseek-ai/dsh-api-session-controller 提供，但只有 @deepseek-ai/dsh-client-ui-conversation 把该行拉进客户端组合；少了它，CTF tab 的会话门控会静默降级成「任何会话都显示」。@deepseek-ai/dsh-client-locale 用于 tab 文案跟随语言（ui-conversation 自己也会拉，一并声明保证顺序）。dsh-pentest 用的是同一组 inject。",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "author": "D1a0y1bb",
  "homepage": "https://github.com/D1a0y1bb/lingxu-ctf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D1a0y1bb/lingxu-ctf.git"
  },
  "bugs": {
    "url": "https://github.com/D1a0y1bb/lingxu-ctf/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
